pipeline {
    agent any

    environment {
        PROJECT_DIR = 'Day-08-DevSecOps/01-Git-Secret-Scanning'
        GITLEAKS = '/usr/local/bin/gitleaks'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Verify Gitleaks') {
            steps {
                sh '''
                    echo "Checking Gitleaks installation"
                    $GITLEAKS version
                '''
            }
        }

        stage('Secret Scanning') {
            steps {
                dir("${PROJECT_DIR}") {
                    sh '''
                        echo "Starting Gitleaks security scan"

                        $GITLEAKS dir . \
                          --config=config/gitleaks.toml \
                          --redact \
                          --report-format json \
                          --report-path reports/gitleaks-report.json
                    '''
                }
            }
        }
    }

    post {
        always {
            echo 'Secret scanning completed.'
        }

        success {
            echo 'SUCCESS: No secrets detected.'
        }

        failure {
            echo 'FAILURE: Secrets detected or scanning failed.'
        }
    }
}
